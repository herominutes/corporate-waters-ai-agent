# The Goodman Protocol — environment template. Copy to .env and fill in. NEVER commit .env.
# (.env, .env.bak*, credentials/ are all gitignored.)

# ===== Core: Telegram (owner channel) =====
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_ALLOWED_USER_ID=    # your Telegram numeric user id (owner)
TIMEZONE=Europe/Vilnius      # owner timezone

# Telethon userbot (DM/group listening) — https://my.telegram.org/apps
TELETHON_API_ID=
TELETHON_API_HASH=
TELETHON_IGNORE_USERNAMES=   # comma-separated usernames to ignore

# ===== HTTP API (VisionClaw / OpenAI-compatible endpoint) =====
API_PORT=8081
API_SECRET=                  # bearer secret for the API endpoint

# ===== Slack (team access) =====
SLACK_BOT_TOKEN=             # xoxb-...
SLACK_APP_TOKEN=             # xapp-... (socket mode)
SLACK_USER_TOKEN=            # xoxp-... (owner user token; bot-only sends for non-owners)
SLACK_OWNER_USER_ID=         # owner's Slack user id (full access)
SLACK_PRIVILEGED_USERS=      # comma-separated Slack user ids granted tool access
# --- authorization gates (see project_saul_privileged_action_gates) ---
SLACK_BOARD_DATA_USERS=      # comma-separated ids allowed confidential board sheets
SLACK_USER_TIERS=            # per-user tiers, e.g. "U123:recruiter,U456:scheduler"
SLACK_DEFAULT_TIER=full      # floor tier for unmapped privileged users (full|comms|recruiter|scheduler|readonly)
SLACK_CALLER_EMAIL_DOMAINS=acme-corp.example  # domains a non-owner may email on owner's behalf

# ===== LLM / AI =====
OPENAI_API_KEY=              # image gen + tools
GEMINI_API_KEY=              # google-genai
ELEVENLABS_API_KEY=          # TTS (optional)
ELEVENLABS_VOICE_ID=
# NOTE: the brain shells out to the `claude` CLI — install + auth it separately (see SETUP.md)

# ===== Work tools =====
CONFLUENCE_BASE_URL=
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
CONFLUENCE_DEFAULT_SPACE=
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# ===== Finance / travel (optional) =====
TRAVELPAYOUTS_TOKEN=


# ===== DemoATS (recruiting) =====
HUNTFLOW_BASE_URL=
HUNTFLOW_UI_BASE=
HUNTFLOW_ACCOUNT_ID=
HUNTFLOW_ACCESS_TOKEN=
HUNTFLOW_REFRESH_TOKEN=
